# ============================================================
# 飞书自建网站应用 · 环境变量模板
# 复制为 .env 后填写真实值：cp .env.example .env
# ============================================================

# ---- 飞书开发者后台 → 凭证与基础信息 ----
# App ID（cli_xxxxxxxx）
FEISHU_APP_ID=
# App Secret
FEISHU_APP_SECRET=

# ---- 回调地址（必须和飞书后台「重定向 URL」完全一致） ----
# 格式：https://your.domain.com/auth/callback
# 本地调试用内网穿透地址：https://xxx.loca.lt/auth/callback
FEISHU_REDIRECT_URI=

# ---- 授权范围（可选，逗号分隔） ----
# 基础免登不需要 scope；如需获取用户手机号/邮箱等，按需添加
# 常用：contact:user.base:readonly  contact:user.employee_id:readonly
# 如需 refresh_token 长期会话，必须加 offline_access
FEISHU_SCOPE=

# ---- 会话安全 ----
# 用于 AES-256-GCM 加密 session cookie 的密钥
# 生成方式：openssl rand -hex 32
# ⚠️ 绝对不要提交到 Git
SESSION_SECRET=please_change_me_to_a_random_32_byte_hex

# ---- 服务配置 ----
PORT=3000
NODE_ENV=development

# ---- 会话过期时间（秒） ----
# 默认 7 天（604800 秒）
SESSION_TTL=604800

# ============================================================
# 多维表格（Bitable）直连（policy-kb 迁移「阶段 1」数据通道）
# 复用上方 FEISHU_APP_ID / FEISHU_APP_SECRET（同一自建应用），无需新增变量。
# 除 SSO 外还需：
#   1) 开发者后台 → 权限管理：开通「多维表格」bitable:app（读写）或
#      bitable:app:readonly（先做只读验证）；新加权限后需「创建版本并发布」。
#   2) 目标多维表格 → 右上角分享 → 添加协作者 → 搜应用名称/App ID → 授「可编辑」。
# 验证：node scripts/probe-bitable.js            （读最低工资表前 5 条）
#       node scripts/probe-bitable.js --all      （遍历十类专题表报总数）
# 实现：src/bitable.js（tenant_access_token 自动缓存 + 字段/记录/批量读写）

# ── 可选：采集/比对走真 LLM（OpenAI 兼容接口）────────────────────────
# 配了之后页面「采集并比对」/「AI 提取」由大模型精提取+语义查重；不配回落本地正则。
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=deepseek-chat
# ============================================================

