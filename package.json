{
  "name": "feishu-webapp",
  "version": "1.0.0",
  "private": true,
  "description": "飞书开放平台「自建网站应用」最小骨架：飞书只做工作台入口 + 单点登录，业务代码跑在自己的服务器上",
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "start:prod": "node policy-api/src/server.js",
    "scf": "node deploy/sls.js",
    "preflight": "node scripts/preflight.js",
    "preflight:local": "node scripts/preflight.js --local",
    "quality": "node scripts/scan-quality.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "http-proxy-middleware": "^4.2.0"
  }
}
